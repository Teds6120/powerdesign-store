{
  "version": 2,
  "builds": [
    {
      "src": "index_new.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index_new.html"
    },
    {
      "src": "/index.html",
      "dest": "/index_new.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
